# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud -> App settings -> Secrets. Never commit the real file.

ANTHROPIC_API_KEY = "sk-ant-your-key-here"

# Optional
# AGENT_MODEL = "claude-sonnet-5-5"
# GOOGLE_PLACES_API_KEY = ""  # only needed to re-fetch providers (python -m providers.fetch)

# Password screen before the app (leave unset locally to skip it).
APP_PASSWORD = "choose-a-password"

# Public demo mode: hides "Past conversations" and writes no leads/transcripts to disk.
DEPLOYED = "true"
