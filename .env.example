# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=

# Optional model overrides
AGENT_MODEL=claude-sonnet-5-5
EXTRACT_MODEL=claude-haiku-4-5-20251001   # extraction only; replies stay on AGENT_MODEL
SIMULATOR_MODEL=claude-haiku-5-5

# Optional: password screen and public demo mode (see .streamlit/secrets.toml.example)
APP_PASSWORD=
DEPLOYED=

# Optional, LOCAL ONLY: LangSmith tracing. Each turn is one trace tagged with its
# thread_id (grouped as a LangSmith thread) and source ("app"/"test").
# Always off when DEPLOYED=true. Don't put these in Streamlit Cloud secrets.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nearby-agent


# Optional: anonymous usage analytics in Supabase (outcomes only: no messages,
# names, phones, emails, zips or addresses). Off when these aren't set.
# The service key stays on the server; never expose it in a browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Password for the admin stats page (/stats). Use something different from APP_PASSWORD.
ADMIN_PASSWORD=
